# =====================================================================
# TAPPING SaaS Environment Variables
# =====================================================================

# Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (configured in Supabase Auth Provider settings or NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Subscriptions & NFC Card Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook
